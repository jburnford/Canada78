#!/bin/bash
#SBATCH --job-name=qwen38-sched1902
## no --partition: plato's submit filter rejects explicit partition names for
## this account and auto-routes by --gres (gpu:3g.40gb:1 → plato_gpu_short)
#SBATCH --gres=gpu:3g.40gb:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=06:00:00
#SBATCH --output=%x-%j.out
#
# Serve Qwen3.8-27B-FP8 with vLLM on one A100 40GB MIG slice (plato) and run
# the 1902-Schedule extraction benchmark against it (eval/extract_1902.py),
# then optionally the retrieval eval. Everything runs inside the vLLM
# container; the client is plain-urllib Python so no extra packages.
#
# One-time setup on the login node (see cluster/plato_setup.sh):
#   $C50/models/Qwen3.8-27B-FP8      model weights (HF snapshot, ~29 GB)
#   $C50/containers/vllm.sif         singularity image of vllm/vllm-openai
#   $C50/Canada50                    this repo (git clone)
#
# Submit:  sbatch cluster/plato_qwen38.slurm            (from $C50/Canada50)
# Vars:    EFFORT=medium CHUNKS=0,5 MAXLEN=65536 sbatch ...

set -euo pipefail
C50=${C50:-$HOME/projects/canada50}
REPO=${REPO:-$C50/Canada50}
MODEL_DIR=${MODEL_DIR:-$C50/models/Qwen3.8-27B-FP8}
SIF=${SIF:-$C50/containers/vllm.sif}
MODEL_NAME=${MODEL_NAME:-Qwen/Qwen3.8-27B-FP8}
MAXLEN=${MAXLEN:-40960}   # chunks are ≤13K tokens in, ≤32K out; 40 GB slice can't afford more KV
EFFORT=${EFFORT:-medium}
PORT=${PORT:-8000}
OUT=${OUT:-$REPO/eval/results/sched1902_qwen38_${EFFORT}}

echo "node $(hostname)  job $SLURM_JOB_ID  $(date)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true

mkdir -p "$OUT"
export HF_HUB_OFFLINE=1 HF_HOME=$C50/hf_cache VLLM_LOGGING_LEVEL=INFO

# ---- pick runtime: pip venv (preferred) or apptainer container (fallback)
if [ -x "$C50/vllm_venv/bin/vllm" ]; then
  RUN=("$C50/vllm_venv/bin/python3")
  CLIENT_PY=("$C50/vllm_venv/bin/python3")
else
  module load apptainer/1.4.5 2>/dev/null || module load apptainer 2>/dev/null || module load singularity 2>/dev/null || true
  CTR=$(command -v apptainer || command -v singularity)
  export APPTAINERENV_HF_HUB_OFFLINE=1 APPTAINERENV_HF_HOME=$C50/hf_cache
  RUN=("$CTR" exec --nv --bind "$C50":"$C50" --bind "$REPO":"$REPO" "$SIF" python3)
  CLIENT_PY=("$CTR" exec --bind "$REPO":"$REPO" "$SIF" python3)
fi

# ---- start the server (background)
"${RUN[@]}" -m vllm.entrypoints.openai.api_server \
    --model "$MODEL_DIR" --served-model-name "$MODEL_NAME" \
    --port "$PORT" --host 127.0.0.1 \
    --max-model-len "$MAXLEN" --gpu-memory-utilization "${GPU_UTIL:-0.93}" \
    --max-num-seqs "${MAX_SEQS:-4}" \
    --limit-mm-per-prompt '{"image":0,"video":0}' \
    ${EAGER:+--enforce-eager} \
    --enable-auto-tool-choice --tool-call-parser qwen3_coder \
    --reasoning-parser qwen3 \
    --trust-remote-code \
    > "$OUT/vllm-server-$SLURM_JOB_ID.log" 2>&1 &
SERVER=$!
trap 'kill $SERVER 2>/dev/null || true' EXIT

# ---- wait for /health (model load from GPFS can take several minutes)
for i in $(seq 1 240); do
  if curl -sf "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then echo "server up after ${i}x5s"; break; fi
  if ! kill -0 $SERVER 2>/dev/null; then echo "server died — see $OUT/vllm-server-$SLURM_JOB_ID.log"; exit 1; fi
  sleep 5
done
curl -sf "http://127.0.0.1:$PORT/v1/models" | head -c 300; echo

# ---- smoke test
curl -s "http://127.0.0.1:$PORT/v1/chat/completions" -H 'Content-Type: application/json' -d "{
  \"model\": \"$MODEL_NAME\", \"max_tokens\": 64, \"chat_template_kwargs\": {\"enable_thinking\": false},
  \"messages\": [{\"role\": \"user\", \"content\": \"Reply with the single word: ready\"}]}" | head -c 400; echo

# ---- Schedule extraction
# Default: the 1902 benchmark chunks. With EDITIONS="1897 1898 1899 1900 1901",
# loop the schedule editions generated by eval/make_schedule_chunks.py.
if [ -n "${EDITIONS:-}" ]; then
  # TASK=schedule (default) → reserves_schedules/chunks_$Y → results/sched$Y_…
  # TASK=census            → census_tables/chunks_$Y     → results/census$Y_…
  TASK=${TASK:-schedule}
  case "$TASK" in census) CDIR=census_tables; PFX=census;; school) CDIR=school_tables; PFX=school;; officers) CDIR=officers_tables; PFX=officers;; table) CDIR=tabstmt_tables; PFX=tabstmt;; agstat) CDIR=agstat_tables; PFX=agstat; QTASK=table;; agrep) CDIR=agreport_tables; PFX=agrep; QTASK=table;; *) CDIR=reserves_schedules; PFX=sched;; esac
  for Y in $EDITIONS; do
    echo "==== $TASK $Y $(date)"
    "${CLIENT_PY[@]}" "$REPO/eval/extract_1902.py" --base-url "http://127.0.0.1:$PORT/v1" \
      --model "$MODEL_NAME" --reasoning-effort "$EFFORT" --edition "$Y" --task "${QTASK:-$TASK}" \
      --chunks-dir "$REPO/registries/external/$CDIR/chunks_$Y" \
      --out "$REPO/eval/results/${PFX}${Y}_qwen38_${EFFORT}" \
      --parallel "${PARALLEL:-3}" ${CHUNKS:+--chunks "$CHUNKS"} ${FORCE:+--force} ${N_WINDOWS:+--n-windows "$N_WINDOWS"}
  done
else
  "${CLIENT_PY[@]}" "$REPO/eval/extract_1902.py" --base-url "http://127.0.0.1:$PORT/v1" \
    --model "$MODEL_NAME" --out "$OUT" --reasoning-effort "$EFFORT" \
    --parallel "${PARALLEL:-1}" \
    ${CHUNKS:+--chunks "$CHUNKS"} ${FORCE:+--force} ${N_WINDOWS:+--n-windows "$N_WINDOWS"}
fi

echo "extraction done $(date)"
